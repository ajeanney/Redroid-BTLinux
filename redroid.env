# Runtime identity
BASE_IMAGE=redroid/redroid@sha256:11d58a64bfbde2253d1cce81bff409ff58174980222d1bada232d9ef59181191
LOCAL_IMAGE=redroid-local:14-btlinux
CONTAINER_NAME=redroid14-bt

# Host integration
ADB_HOST=127.0.0.1
ADB_PORT=5555
BT_ADAPTER=hci0
BT_EXPECTED_USB_ID=8087:0033
NFT_TABLE=redroid_guard
HOST_NETNS_SOURCE=/proc/1/ns/net
REDROID_DATA_DIR=./data

# Virtual display
REDROID_WIDTH=1080
REDROID_HEIGHT=1920
REDROID_DPI=420
REDROID_FPS=60
REDROID_GPU_MODE=host
REDROID_NATIVE_BRIDGE=libndk_translation.so

# Startup timeout in seconds
BOOT_TIMEOUT=180
